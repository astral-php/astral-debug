{
    "name": "astral-php/astral-debug",
    "description": "Barre de debug Astral \u2014 temps, m\u00e9moire, SQL, messages (dev uniquement)",
    "type": "library",
    "version": "0.2.0",
    "license": "MIT",
    "keywords": [
        "astral",
        "php",
        "debug",
        "toolbar",
        "dx"
    ],
    "authors": [
        {
            "name": "astral-php",
            "homepage": "https://github.com/astral-php"
        }
    ],
    "homepage": "https://github.com/astral-php/astral-debug",
    "require": {
        "php": "^8.3",
        "astral-php/astral-core": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AstralDebug\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AstralDebug\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
